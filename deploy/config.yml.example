# REBLOS node config for the Docker + Caddy deploy. Copy to config.yml and edit.
# Secrets are NOT here: they come from .env (R2_ACCESS_KEY / R2_SECRET_KEY, or
# S3_ACCESS_KEY / S3_SECRET_KEY). A NIP-CHAT relay + Blossom server for your hubs.

listen: ":3000"                          # Caddy forwards here (container-internal)
public_url: "https://relay.example.com"  # YOUR public hostname, must change (it's what the node announces)
data_dir: "/app/data"                    # the mounted volume; do not change

backend: "disk"                          # "disk" (blobs on this box), "r2", or "s3"

log:
  level: "info"
  format: "json"                         # structured logs for the server

# Only the block matching `backend` above is used.
r2:
  endpoint: "<accountid>.r2.cloudflarestorage.com"   # R2 → Settings → S3 API
  region: "auto"
  bucket: "your-blossom-bucket"
  use_ssl: true

s3:                                      # self-hosted S3 (MinIO / Garage / Ceph)
  endpoint: "garage:3900"                # host[:port], no scheme (a compose service)
  region: "garage"
  bucket: "your-blossom-bucket"
  use_ssl: false                         # internal network, no TLS needed
  path_style: true                       # most self-hosted S3 servers need this

disk:
  path: "/app/data/blobs"                # blob root when backend is "disk"

# Optional read-fallback backend, for re-routing storage WITHOUT losing blobs.
# Set its backend to your OLD store and the primary above to the NEW one, restart
# (reads fall through to the fallback), then run the migration (dashboard Storage
# tab) to copy the backlog into the primary, and finally remove this block. Its
# secrets come from FALLBACK_R2_ACCESS_KEY / FALLBACK_R2_SECRET_KEY (or FALLBACK_S3_*).
# fallback:
#   backend: "r2"
#   r2:
#     endpoint: "<old-accountid>.r2.cloudflarestorage.com"
#     bucket: "old-bucket"
#     use_ssl: true

upload:
  max_size_mb: 500
  max_concurrent: 4
  min_free_disk_mb: 1024
  # Accepted upload types (magic-detected / text-sniffed). Omit to use the default
  # (text + common image/audio/video). "txt" MUST stay for hub member trees. ["*"]
  # = any; add "zip"/"rar"/"7z"/"exe"/"gz" to also accept archives/binaries.
  # allowed_types: ["txt", "png", "jpg", "gif", "webp", "mp4", "webm", "mp3"]

relay:
  # YOUR npub. It is the only key allowed to use the NIP-86 management API and the
  # admin dashboard (whitelist hubs, moderate, manage sync relays). Leave it empty
  # and the admin surface is closed to everyone.
  admin_npub: "npub1youradminkey"
  min_event_pow: 0
  # Extra event kinds to accept beyond the built-in NIP-CHAT hub set. NOT member-
  # gated; they pass the kind allowlist + min_event_pow only. e.g. [1059] for DMs.
  # extra_kinds: []
  # Drop the kind allowlist AND the hub member gate: accept any kind, from anyone.
  # For a general-purpose fork. Bans, takedowns and honored deletions still apply;
  # set min_event_pow above if you turn this on.
  accept_all_kinds: false

download:
  # START WITH THE GATE OFF. Verify upload + read first, then turn it on.
  pow_difficulty: 0                      # e.g. 18-20 to enable the PoW download gate
  challenge_ttl: 600
  trusted_ip_header: "X-Forwarded-For"   # Caddy sets this to the real client IP

announce:
  # Advertise this node over Nostr so other nodes/clients can discover it.
  enabled: true
  interval_hours: 168                    # re-publish weekly (7 days)
  relays:
    - "wss://relay.primal.net"
    - "wss://nos.lol"
    - "wss://relay.damus.io"

sync:
  # Durability sync (REBLOS-MIGRATION §6): per whitelisted hub, pull its events +
  # Blossom blobs from the hub's OWN relay hints PLUS a curated set of general
  # relays, member-gated, so nothing is lost on downtime. The general relays are
  # seeded with sensible defaults and then managed from the dashboard (Sync tab):
  # toggle a default off or add your own. extra_relays below only SEED the list on
  # first run; after that the dashboard is the source of truth.
  interval_minutes: 15
  extra_relays: []
    # - "wss://your-extra-relay.example"
